        "--tags=wcp-db",
        "--shielded-secure-boot",
        "--shielded-vtpm",
        "--shielded-integrity-monitoring",
        "--deletion-protection",
        "--metadata=enable-oslogin=TRUE,block-project-ssh-keys=TRUE",
        "--metadata-from-file=startup-script=deployment/postgres-startup.sh",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization",
        "account_compute_and_disk_allowance_checked",
        "reviewed_cos_image",
        "postgres_image_mirrored"
