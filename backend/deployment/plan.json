    {
      "name": "Deploy private application for validation",
      "program": "gcloud",
      "args": [
        "run",
        "deploy",
        "woundcopilot",
        "--region=us-central1",
        "--image=us-central1-docker.pkg.dev/woundcopilot-20260905/wcp/app@sha256:1638ee0388e7337754f82e622444bf2e08eadce42c1356612788cdd0393305f1",
        "--service-account=wcp-run@woundcopilot-20260905.iam.gserviceaccount.com",
        "--network=wcp-vpc",
        "--subnet=wcp-private",
        "--vpc-egress=private-ranges-only",
        "--network-tags=wcp-run",
        "--min=0",
        "--max=1",
        "--min-instances=0",
        "--max-instances=1",
        "--cpu=1",
        "--memory=1Gi",
        "--cpu-throttling",
        "--no-cpu-boost",
        "--concurrency=8",
        "--timeout=300",
