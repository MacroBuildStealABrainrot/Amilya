        "wcp-private",
        "--network=wcp-vpc",
        "--range=10.30.0.0/26",
        "--region=us-central1",
        "--enable-private-ip-google-access",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization"
      ]
    },
    {
