        "firewall-rules",
        "create",
        "wcp-iap-ssh",
        "--network=wcp-vpc",
        "--direction=INGRESS",
        "--action=ALLOW",
        "--rules=tcp:22",
        "--source-ranges=35.235.240.0/20",
        "--target-tags=wcp-db",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization"
