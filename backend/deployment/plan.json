        "--member=serviceAccount:wcp-run@woundcopilot-20260905.iam.gserviceaccount.com",
        "--role=roles/secretmanager.secretAccessor",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization",
        "secrets_created_out_of_band"
      ]
    },
    {
