        "--subnet=wcp-private",
        "--private-network-ip=10.30.0.10",
        "--no-address",
        "--image-family=cos-stable",
        "--image-project=cos-cloud",
        "--boot-disk-type=pd-standard",
        "--boot-disk-size=10GB",
        "--disk=name=wcp-data,device-name=wcp-data,mode=rw,auto-delete=no",
        "--service-account=wcp-db@woundcopilot-20260905.iam.gserviceaccount.com",
