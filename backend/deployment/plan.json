  "steps": [
    {
      "name": "Enable selected APIs",
      "program": "gcloud",
      "args": [
        "services",
        "enable",
        "compute.googleapis.com",
        "run.googleapis.com",
        "artifactregistry.googleapis.com",
        "secretmanager.googleapis.com",
        "iap.googleapis.com",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization"
      ]
    },
    {
      "name": "Create isolated VPC",
      "program": "gcloud",
      "args": [
        "compute",
        "networks",
        "create",
        "wcp-vpc",
        "--subnet-mode=custom",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization"
      ]
    },
    {
      "name": "Create private subnet",
      "program": "gcloud",
      "args": [
        "compute",
        "networks",
        "subnets",
