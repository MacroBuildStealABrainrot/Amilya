        "--source-tags=wcp-run",
        "--target-tags=wcp-db",
        "--project=woundcopilot-20260905",
        "--quiet"
      ],
      "requires": [
        "owner_review_and_billing_authorization"
      ]
    },
    {
      "name": "Allow operator SSH through IAP",
      "program": "gcloud",
      "args": [
