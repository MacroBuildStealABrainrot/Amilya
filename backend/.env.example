# Copy to .env locally. Never commit real values or place them in frontend code.
ENVIRONMENT=development
APP_SECRET=replace-with-at-least-32-cryptographically-random-characters
DATABASE_URL=sqlite:///./work/woundcopilot.db
PUBLIC_BASE_URL=http://127.0.0.1:8766
TRUSTED_HOSTS=127.0.0.1,localhost
SECURE_COOKIES=false
ALLOW_SIGNUP=true
# Operator-only comma-separated immutable user IDs. Does not grant administrator access.
UNLIMITED_CREDIT_USER_IDS=
AUTO_CREATE_SCHEMA=false
FRONTEND_PATH=frontend/dist

# User requested configured integrations with execution paused until funding/verification.
PROVIDER_EXECUTION_ENABLED=false
CLINICAL_DATA_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_REQUIRE_ZDR=true
OPENROUTER_PHI_APPROVED=false
MODEL_EXTRACTION=openai/gpt-5.6-luna
MODEL_VISION=openai/gpt-5.6-luna
MODEL_DOCUMENTATION=openai/gpt-5.6-luna
MODEL_REVIEW=openai/gpt-5.6-sol
MODEL_FRONTIER=openai/gpt-5.6-sol
MODEL_CHALLENGER=anthropic/claude-fable-5.1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PHI_APPROVED=false
GROQ_API_KEY=
GROQ_PHI_APPROVED=false
GROQ_ZDR_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_ENABLED=false
DEEPGRAM_PHI_APPROVED=false
SPEECH_PROVIDER=auto
MAX_AUDIO_SECONDS=3600
MAX_AUDIO_MB=25
MAX_IMAGE_MB=12
MAX_DOCUMENT_MB=20

BILLING_ENABLED=false
STRIPE_LIVE_MODE=false
STRIPE_API_VERSION=2026-08-26.dahlia
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_POWER=
STRIPE_PRICE_TOPUP=

# A real operator must supply these before commercial launch.
LEGAL_VERSION=2026-09-05
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
PRIVACY_EMAIL=
# Used only by docker compose; use URL-safe characters.
POSTGRES_PASSWORD=
