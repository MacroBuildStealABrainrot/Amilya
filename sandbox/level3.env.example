# Copy this file to level3.env and fill in YOUR OWN keys. level3.env stays on your PC.
# Never paste these keys into a chat, an email, the app, or a ZIP you share.
# Level 3 sends FAKE (synthetic) speech and text to these AI companies, and they may charge your account.
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_ENABLED=false
SPEECH_PROVIDER=auto
