+# One-time setup. Installs Python packages into sandbox\.venv. Touches nothing outside this project folder.
+. "$PSScriptRoot\_common.ps1"
+$py = Get-Command python -ErrorAction SilentlyContinue
+if (-not $py) { throw 'Python 3.11 or newer is needed. Install it from python.org (tick "Add python.exe to PATH"), then run this again.' }
+$version = & python -c "import sys;print('%d.%d' % sys.version_info[:2])"
+if ([version]$version -lt [version]'3.11') { throw "Python $version found; 3.11 or newer is needed." }
+if (-not (Get-Command ffmpeg -ErrorAction SilentlyContinue) -or -not (Get-Command ffprobe -ErrorAction SilentlyContinue)) {
+    Write-Host 'ffmpeg/ffprobe not found. Install with: winget install Gyan.FFmpeg   then open a NEW PowerShell window. (Needed for audio checks in Level 3.)' -ForegroundColor Yellow
+}
+if (-not (Test-Path -LiteralPath $VenvPython)) { & python -m venv (Join-Path $SandboxDir '.venv') }
+& $VenvPython -m pip install --upgrade pip
+& $VenvPython -m pip install -r (Join-Path $BackendDir 'requirements.txt')
+if ($LASTEXITCODE -ne 0) { throw 'Python packages could not be installed.' }
+Write-Host 'Setup finished.' -ForegroundColor Green

--- a/sandbox/_common.ps1
+++ b/sandbox/_common.ps1
@@ -0,0 +1,24 @@
+# Shared helpers for the sandbox scripts. Not meant to be run on its own.
+$ErrorActionPreference = 'Stop'
+$script:SandboxDir = $PSScriptRoot
+$script:ProjectDir = Split-Path -Parent $PSScriptRoot
+$script:BackendDir = Join-Path $ProjectDir 'backend'
+$script:VenvPython = Join-Path $SandboxDir '.venv\Scripts\python.exe'
+$script:Port = 18766
+
+function Assert-SetupDone {
+    if (-not (Test-Path -LiteralPath $VenvPython)) { throw 'Run .\Setup-Sandbox.ps1 first (one time).' }
+    if (-not (Test-Path -LiteralPath (Join-Path $BackendDir 'server\main.py'))) { throw "Backend folder not found at $BackendDir" }
+}
+function Assert-PortFree {
+    $busy = Get-NetTCPConnection -State Listen -LocalPort $Port -ErrorAction SilentlyContinue
+    if ($busy) { throw "Port $Port is already in use. Close the other sandbox window first (Ctrl+C)." }
+}
+function Set-PhoneLink {
+    $adb = Get-Command adb -ErrorAction SilentlyContinue
+    if (-not $adb) { Write-Host 'adb was not found. Add Android SDK platform-tools to PATH, then run: adb reverse tcp:18766 tcp:18766' -ForegroundColor Yellow; return }
+    $devices = & adb devices | Select-String -Pattern "`tdevice$"
+    if (-not $devices) { Write-Host 'No phone found by adb. Plug in the Samsung, allow USB debugging, then run: adb reverse tcp:18766 tcp:18766' -ForegroundColor Yellow; return }
+    & adb reverse tcp:18766 tcp:18766 | Out-Null
+    Write-Host 'Phone linked: the phone can reach this PC test server at 127.0.0.1:18766 (USB only).' -ForegroundColor Green
+}

--- a/sandbox/_level3_env.ps1
+++ b/sandbox/_level3_env.ps1
@@ -0,0 +1,32 @@
+# Builds the Level 3 settings. Safety values are forced here and cannot be overridden by level3.env.
+. "$PSScriptRoot\_common.ps1"
+$envFile = Join-Path $SandboxDir 'level3.env'
+if (-not (Test-Path -LiteralPath $envFile)) { throw 'Copy level3.env.example to level3.env and add your own AI keys first.' }
+$workDir = Join-Path $SandboxDir 'work'
+New-Item -ItemType Directory -Force -Path $workDir | Out-Null
+$secretFile = Join-Path $workDir 'level3-secret.txt'
+if (-not (Test-Path -LiteralPath $secretFile)) {
+    $bytes = New-Object byte[] 48
+    $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
+    try { $rng.GetBytes($bytes) } finally { $rng.Dispose() }
+    [System.IO.File]::WriteAllText($secretFile, [Convert]::ToBase64String($bytes))
+}
+if (-not ((Get-Content -LiteralPath $envFile) -match '^OPENROUTER_API_KEY=.+')) { Write-Host 'Note: OPENROUTER_API_KEY is empty in level3.env, so report writing will not work.' -ForegroundColor Yellow }
+$env:WOUNDCOPILOT_ENV_FILE = $envFile
+$env:APP_SECRET = (Get-Content -LiteralPath $secretFile -Raw).Trim()
+$env:ENVIRONMENT = 'development'
+$env:DATABASE_URL = 'sqlite:///' + ((Join-Path $workDir 'level3-test.db') -replace '\\', '/')
+$env:PUBLIC_BASE_URL = 'http://127.0.0.1:18766'
+$env:TRUSTED_HOSTS = '127.0.0.1,localhost'
+$env:SECURE_COOKIES = 'false'
+$env:ALLOW_SIGNUP = 'true'
+$env:AUTO_CREATE_SCHEMA = 'false'
+$env:BILLING_ENABLED = 'false'
+$env:STRIPE_SECRET_KEY = ''
+$env:CLINICAL_DATA_ENABLED = 'false'     # fake data only
+$env:PROVIDER_EXECUTION_ENABLED = 'true'  # the only thing Level 3 turns on: real AI for fake data
+Push-Location $BackendDir
+try {
+    & $VenvPython -m alembic upgrade head
+    if ($LASTEXITCODE -ne 0) { throw 'Test database setup failed.' }
+} finally { Pop-Location }

