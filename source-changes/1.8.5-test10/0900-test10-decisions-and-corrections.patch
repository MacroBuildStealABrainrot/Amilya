--- a/ci/run-phone-tests.sh	1969-12-31 19:00:00.000000000 -0500
+++ b/ci/run-phone-tests.sh	2026-10-24 23:08:07.784695479 -0400
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Runs the sandbox app's phone tests on the CI emulator. Called by .github/workflows/amilya-sandbox-ci.yml.
+# Servers are throw-away and local to this job: Level 1 = real backend code, empty database, AI and billing OFF;
+# Level 2 = pretend server with fixed fake answers. No real patient data, no AI, no production address.
+set -u
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"; OUT="$ROOT/ci-out"; mkdir -p "$OUT"
+adb wait-for-device
+adb reverse tcp:18766 tcp:18766
+adb logcat -c || true
+
+start_server() { # $1 = python file, $2 = label
+  python "$1" > "$OUT/$2-server.log" 2>&1 & echo $! > /tmp/wcp-server.pid
+  for _ in $(seq 1 60); do (echo > /dev/tcp/127.0.0.1/18766) 2>/dev/null && return 0; sleep 1; done
+  echo "server $2 did not start" >> "$OUT/summary.txt"; return 1
+}
+stop_server() { kill "$(cat /tmp/wcp-server.pid)" 2>/dev/null; sleep 2; }
+
+run_group() { # $1 = label, $2 = comma-separated test classes ("" = all)
+  local args=()
+  [ -n "$2" ] && args+=("-Pandroid.testInstrumentationRunnerArguments.class=$2")
+  (cd "$ROOT/android" && ./gradlew --no-daemon :app:connectedSandboxAndroidTest "${args[@]}") > "$OUT/$1.log" 2>&1
