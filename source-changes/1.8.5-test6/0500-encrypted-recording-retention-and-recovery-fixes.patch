+        while (p < bytes.size) {
+            val len = Adts.frameLength(bytes, p, bytes.size - p, rate, 1); assertTrue("genuine frame at $p", len > 0)
+            out += bytes.copyOfRange(p + Adts.HEADER_BYTES, p + len); p += len
+        }
+        return out
+    }
