--- a/verification/python_static_checks.py
+++ b/verification/python_static_checks.py
@@ -0,0 +1,18 @@
+"""Checks that need no installed packages: every Python file parses, and no async server code runs a blocking program directly.
+Usage: python verification/python_static_checks.py   (run from the project root)"""
+import ast, sys
+from pathlib import Path
+root = Path(__file__).resolve().parents[1]
+files = [p for d in ('backend/server', 'backend/tests', 'backend/scripts', 'backend/migrations', 'test-tools', 'android/tools') for p in sorted((root / d).rglob('*.py'))]
+bad = []
+for p in files:
+    try: ast.parse(p.read_text(encoding='utf-8'), str(p))
+    except SyntaxError as e: bad.append((str(p), str(e)))
+print(f'parsed {len(files)} Python files, syntax errors: {len(bad)}', *bad)
+src = (root / 'backend/tests/test_audio_event_loop.py').read_text(encoding='utf-8')
+keep = [n for n in ast.parse(src).body if (isinstance(n, ast.Assign) and any(getattr(t, 'id', '') in ('BLOCKING', 'SUBPROCESS_CALLS') for t in n.targets))
+        or (isinstance(n, ast.FunctionDef) and n.name == 'direct_blocking_calls')]
+ns = {'ast': ast}; exec(compile(ast.Module(keep, []), 'guard', 'exec'), ns)
+offenders = {p.name: h for p in sorted((root / 'backend/server').glob('*.py')) if (h := ns['direct_blocking_calls'](p.read_text(encoding='utf-8')))}
+print('async functions that run a blocking program directly:', offenders or 'none')
+sys.exit(1 if bad or offenders else 0)

--- a/verification/run_kotlin_logic_tests.sh
+++ b/verification/run_kotlin_logic_tests.sh
@@ -0,0 +1,14 @@
+#!/bin/sh
+# Re-runs the pure-logic Kotlin tests WITHOUT Android, using the Kotlin compiler that ships inside a Gradle install.
+# Usage: sh run_kotlin_logic_tests.sh /path/to/gradle-home   (the folder that contains lib/kotlin-compiler-embeddable-*.jar)
+# Not a replacement for the real Android build. It only proves the pure logic (CSRF rules, retry rules, sandbox address guard, watch protocol).
+set -e
+G="${1:?give the Gradle install folder}"; L="$G/lib"; HERE="$(cd "$(dirname "$0")/.." && pwd)"
+KC=$(ls "$L"/kotlin-compiler-embeddable-*.jar); SL=$(ls "$L"/kotlin-stdlib-[0-9]*.jar | head -1)
+CP="$KC:$SL:$(ls "$L"/kotlin-script-runtime-*.jar):$(ls "$L"/kotlin-reflect-*.jar):$(ls "$L"/kotlin-daemon-embeddable-*.jar):$(ls "$L"/trove4j-*.jar):$(ls "$L"/annotations-*.jar | head -1):$(ls "$L"/kotlinx-coroutines-core-jvm-*.jar)"
+JU="$SL:$(ls "$L"/junit-4*.jar):$(ls "$L"/hamcrest-core-*.jar)"
+W="$(mktemp -d)"; python3 -I "$HERE/verification/extract_pure_kotlin.py" "$HERE" "$W/Extracted.kt"
+java -cp "$CP" org.jetbrains.kotlin.cli.jvm.K2JVMCompiler -no-stdlib -no-reflect -cp "$JU" -d "$W/out" "$W/Extracted.kt" "$HERE"/android/app/src/test/java/com/woundcopilot/android/*.kt
+java -cp "$W/out:$JU" org.junit.runner.JUnitCore com.woundcopilot.android.CsrfBootstrapTest com.woundcopilot.android.CsrfRecoveryTest com.woundcopilot.android.ApiOriginGuardTest
+java -cp "$CP" org.jetbrains.kotlin.cli.jvm.K2JVMCompiler -no-stdlib -no-reflect -cp "$JU" -d "$W/outw" $(find "$HERE/android/wear-contract/src" -name '*.kt')
+java -cp "$W/outw:$JU" org.junit.runner.JUnitCore $(grep -h '^class ' -r "$HERE/android/wear-contract/src/test" | sed 's/class \([A-Za-z]*\).*/com.woundcopilot.wear.contract.\1/')
