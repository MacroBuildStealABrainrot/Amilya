+            }finally{bytes.fill(0)}
+            state.put("completed",index+1);vault.write(checkpoint,state.toString())
+        }
+        stage("Preparing transcript")
+        val result=api.call("/encounters/$encounter/audio-complete","POST",obj("job_id" to state.str("job_id"),"count" to count),"${state.str("job_id")}-complete")as JSONObject
+        state.put("result",result);vault.write(checkpoint,state.toString())
+        return result
+    }
