+package com.woundcopilot.android
+
+import android.Manifest
+import android.content.Context
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import androidx.test.rule.GrantPermissionRule
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+import java.io.FileOutputStream
+import kotlin.random.Random
+
+/**
+ * Sandbox-only tests for the EXPERIMENTAL crash-resistant recorder. Not run in this workspace (no Android SDK or device);
+ * they are written for you to run with: connectedSandboxAndroidTest (see RUN-ON-YOUR-PC.md, Step 8).
+ * Uses only the phone's microphone input and made-up audio. No patient data, no network.
+ */
+@RunWith(AndroidJUnit4::class)
+class CrashSafeRecordingTest {
+    @get:Rule val permission: GrantPermissionRule = GrantPermissionRule.grant(Manifest.permission.RECORD_AUDIO, Manifest.permission.POST_NOTIFICATIONS)
+    private val context: Context get() = InstrumentationRegistry.getInstrumentation().targetContext
+    private val created = mutableListOf<String>()
+
+    @After fun cleanUp() {
+        RecordingService.stop(context)
+        waitUntil(10_000) { !RecordingService.state.value.recording }
+        created.forEach { runCatching { RecordingService.clearPending(context, it, deleteFile = true) } }
+        RecordingService.state.value = RecordingState()
+    }
+
+    private fun waitUntil(ms: Long, condition: () -> Boolean): Boolean {
+        val end = System.currentTimeMillis() + ms
+        while (System.currentTimeMillis() < end) { if (condition()) return true; Thread.sleep(50) }
+        return condition()
+    }
+
+    private fun durationMillis(file: File): Long {
+        val r = android.media.MediaMetadataRetriever()
+        return try { r.setDataSource(file.absolutePath); r.extractMetadata(android.media.MediaMetadataRetriever.METADATA_KEY_DURATION)!!.toLong() } finally { r.release() }
+    }
+
+    @Test fun sandboxBuildUsesTheExperimentalRecorder() {
+        assertTrue("This test must run on the sandbox build", BuildConfig.CRASH_SAFE_RECORDING)
+        assertNotNull(crashSafeBackend())
+    }
+
+    @Test fun recordPauseResumeStopGivesOnePlayableFileOfTheRightLength() {
+        RecordingService.start(context)
+        assertTrue(waitUntil(8_000) { RecordingService.state.value.recording })
+        Thread.sleep(6_000)
+        RecordingService.pause(context)
+        assertTrue(waitUntil(5_000) { RecordingService.state.value.paused })
+        Thread.sleep(4_000) // this paused time must NOT appear in the audio
+        RecordingService.resume(context)
+        assertTrue(waitUntil(5_000) { !RecordingService.state.value.paused })
+        Thread.sleep(5_000)
+        RecordingService.stop(context)
+        assertTrue(waitUntil(30_000) { !RecordingService.state.value.recording && RecordingService.state.value.filePath != null })
+        val path = RecordingService.state.value.filePath!!.also { created += it }
+        val file = File(path)
+        assertTrue(RecordingService.readableAudio(file))
+        val seconds = durationMillis(file) / 1000.0
+        assertTrue("expected about 11 s of audio (6 + 5), paused time excluded; got $seconds", seconds in 9.0..13.5)
+    }
+
+    /**
+     * Simulates "Android killed the app mid-recording": a session folder with whole pieces plus a torn last frame,
+     * and no finished .m4a. Opening the pending list must rebuild a playable file from the valid part only.
+     */
+    @Test fun leftBehindSessionIsRebuiltIntoAPlayableRecording() {
+        val root = RecordingService.recordingsDirectory(context)
+        val name = "recording-${System.currentTimeMillis()}-test-orphan.m4a"
+        val dir = File(root, "safe-${name.removeSuffix(".m4a")}").apply { mkdirs() }
+        val rate = CrashSafeBackendImpl.SAMPLE_RATE
+        val perSegment = 400
+        AdtsSegmentWriter(dir, rate, 1, perSegment).use { w ->
+            val rnd = Random(7)
+            repeat(1000) { w.writeFrame(rnd.nextBytes(90)) } // 3 pieces: 400, 400, 200 frames
+        }
+        // tear the last frame: chop 30 bytes off the end of the final piece, like a kill in mid-write
+        val last = SafeSessions.segments(dir).last()
+        FileOutputStream(last, true).channel.use { it.truncate(it.size() - 30) }
+        SessionInfo(dir).write(mapOf("finalName" to name, "status" to "recording", "elapsedMillis" to "1000",
+            "sampleRate" to rate.toString(), "channels" to "1"))
+        RecordingService.writeMetadata(File(root, name), "recording", 1000, null)
+
+        val recovered = RecordingService.pendingRecordings(context).firstOrNull { it.filePath?.endsWith(name) == true }
+        assertNotNull("the interrupted session should be rebuilt", recovered)
+        val file = File(recovered!!.filePath!!).also { created += it.absolutePath }
+        assertTrue(RecordingService.readableAudio(file))
+        val expected = Adts.framesToMillis(999, rate) // 1000 frames minus the torn one
+        val actual = durationMillis(file)
+        assertTrue("expected about $expected ms, got $actual", kotlin.math.abs(actual - expected) < 500)
+        assertTrue("the user must be told it was interrupted", recovered.error?.contains("interrupted") == true)
+        assertEquals(true, dir.isDirectory) // raw pieces are kept until the user confirms upload or discard
+        RecordingService.clearPending(context, file.absolutePath, deleteFile = true)
+        created.clear()
+        assertTrue("discard removes the raw pieces too", !dir.exists())
+    }
+}
