+/**
+ * Writes AAC frames into numbered segment files (seg-00001.aac, ...). A new segment starts only on a frame boundary,
+ * so joining the segments in order gives exactly the frames that were written: nothing lost, nothing repeated.
+ */
+internal class AdtsSegmentWriter(
+    private val directory: File,
+    private val sampleRate: Int,
+    private val channels: Int,
+    private val framesPerSegment: Int,
+    private val syncEveryFrames: Int = 120,
+) : AutoCloseable {
+    init { require(framesPerSegment > 0 && syncEveryFrames > 0) }
+    private var stream: FileOutputStream? = null
+    private var framesInSegment = 0
+    private var sinceSync = 0
+    var framesWritten = 0L; private set
+    var segmentsOpened = 0; private set
+    private var scratch = ByteArray(4096)
+
+    fun segmentFile(number: Int) = File(directory, "seg-%05d.aac".format(number))
+
+    @Throws(IOException::class)
+    fun writeFrame(payload: ByteArray, length: Int = payload.size) {
+        if (stream == null || framesInSegment >= framesPerSegment) rotate()
+        val total = Adts.HEADER_BYTES + length
+        if (scratch.size < total) scratch = ByteArray(total)
+        System.arraycopy(Adts.header(length, sampleRate, channels), 0, scratch, 0, Adts.HEADER_BYTES)
+        System.arraycopy(payload, 0, scratch, Adts.HEADER_BYTES, length)
+        // One write per frame, no extra buffering: once write() returns, the frame survives the app being killed.
+        stream!!.write(scratch, 0, total)
+        framesInSegment++; framesWritten++; sinceSync++
+        if (sinceSync >= syncEveryFrames) syncToDisk()
+    }
+
+    /** Also protects against the phone losing power. A process kill does not need this. */
+    fun syncToDisk() { stream?.fd?.sync(); sinceSync = 0 }
+
+    private fun rotate() {
+        closeCurrent()
+        directory.mkdirs()
+        var number = segmentsOpened + 1
+        while (segmentFile(number).exists()) number++ // never overwrite earlier audio
+        stream = FileOutputStream(segmentFile(number))
+        segmentsOpened = number
+        framesInSegment = 0
+    }
+
+    private fun closeCurrent() {
+        stream?.let { runCatching { it.fd.sync() }; it.close() }
+        stream = null
+    }
+
+    override fun close() { closeCurrent() }
+}
+
+/** One piece of a segment file that may be used: the first [validBytes] bytes. */
+internal data class SegmentSlice(val file: File, val validBytes: Long, val frames: Int, val trailingBytes: Long)
+
+internal data class RecoveryPlan(val slices: List<SegmentSlice>, val sampleRate: Int, val channels: Int) {
+    val totalFrames: Long get() = slices.sumOf { it.frames.toLong() }
+    val durationMillis: Long get() = Adts.framesToMillis(totalFrames, sampleRate)
+    val discardedBytes: Long get() = slices.sumOf { it.trailingBytes }
+    /** True when every segment ended cleanly (nothing was cut off). */
+    val intact: Boolean get() = discardedBytes == 0L
+}
+
+internal object SafeSessions {
+    fun segments(directory: File): List<File> =
+        directory.listFiles { f -> f.isFile && f.name.matches(Regex("seg-\\d{5}\\.aac")) }.orEmpty().sortedBy { it.name }
+
+    /** Works out what can be recovered from a session folder, after a normal stop or after the app was killed. */
+    fun plan(directory: File, sampleRate: Int, channels: Int): RecoveryPlan {
+        val slices = segments(directory).mapNotNull { file ->
+            val scan = AdtsScanner.scan(file, sampleRate, channels)
+            if (scan.frames == 0) null else SegmentSlice(file, scan.validBytes, scan.frames, scan.trailingBytes)
+        }
+        return RecoveryPlan(slices, sampleRate, channels)
+    }
+
+    /** Copies the usable part of every segment, in order, into one stream (used before turning it into an .m4a). */
+    fun join(plan: RecoveryPlan, output: OutputStream) {
+        val buffer = ByteArray(64 * 1024)
+        for (slice in plan.slices) {
+            FileInputStream(slice.file).use { input ->
+                var left = slice.validBytes
+                while (left > 0) {
+                    val n = input.read(buffer, 0, minOf(buffer.size.toLong(), left).toInt())
+                    if (n < 0) throw IOException("Segment ${slice.file.name} became shorter while joining")
+                    output.write(buffer, 0, n)
+                    left -= n
+                }
+            }
+        }
+    }
+}
